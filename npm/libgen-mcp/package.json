    "README.md"
  ],
  "optionalDependencies": {
    "@jmrp.io/libgen-mcp-linux-x64": "1.7.2",
    "@jmrp.io/libgen-mcp-linux-arm64": "1.7.2",
    "@jmrp.io/libgen-mcp-darwin-x64": "1.7.2",
    "@jmrp.io/libgen-mcp-darwin-arm64": "1.7.2",
