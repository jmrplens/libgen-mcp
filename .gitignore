# npm publish set: the six per-platform packages are generated from the release
# binaries at publish time and each carries a ~20 MB executable. The launcher
# under /npm/libgen-mcp/ IS committed; everything below is not.
/npm/packages/
/npm/**/node_modules/
/npm/**/*.tgz

coverage.out
coverage.internal.out
coverage.html
*.test
.superpowers/

# Generated LLM-discovery files published to the site (regenerated from the
# canonical root-level llms.txt / llms-full.txt by site prebuild — not committed)
/site/public/llms.txt
/site/public/llms-full.txt

# Astro build output
/site/dist/
/site/.astro/

# Local planning / spec scratch — not part of the published repo
/plan/
/docs/superpowers/

# Local environment secrets — ANTHROPIC_API_KEY for the gated eval, etc.
# (also covered by the global gitignore; pinned here so a fresh clone is safe)
.env

# Full record of a live evaluator run: prompts, turns, tool calls, server logs
# and answers. Useful locally for post-hoc analysis, too big and too volatile to
# track.
/eval-record.jsonl
