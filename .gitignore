# Written by cmd/gen_third_party_notices when it runs from the repository root;
# the release generates its own copy and no commit holds one.
/THIRD_PARTY_NOTICES

# npm publish set: the six per-platform packages are generated from the release
# binaries at publish time and each carries a ~20 MB executable. The launcher
# under /npm/libgen-mcp/ IS committed; everything below is not.
/npm/packages/
/npm/**/node_modules/
/npm/**/*.tgz
# The launcher's licence texts are copied in by scripts/build-npm.mjs at
# assembly time, so the repository holds each text once; the third-party notices
# are generated with the release and held in no commit at all.
/npm/libgen-mcp/LICENSE
/npm/libgen-mcp/THIRD_PARTY_NOTICES

# PyPI wheelhouse: six platform wheels built from the release binaries at
# publish time. The README under /pypi/ IS committed — it is the long
# description every wheel embeds, and it carries the MCP Registry's ownership
# token — and the wheels are not.
/pypi/dist/

# NuGet packages: seven .nupkg files built from the release binaries at publish
# time. The README under /nuget/ IS committed — it is the long description the
# pointer package ships and the file the MCP Registry reads ownership from.
/nuget/dist/

__pycache__/

coverage.out
coverage.internal.out
coverage.html
# The copy scripts/coverage-mutants.sh stages beside a package main, left
# behind only when a run was killed before its trap could remove it.
*.mutants-*/
*.test
.superpowers/

# Generated LLM-discovery files published to the site (regenerated from the
# canonical root-level llms.txt / llms-full.txt by site prebuild — not committed)
/site/public/llms.txt
/site/public/llms-full.txt

# Astro build output
/site/dist/
/site/.astro/

# Local planning / spec scratch — not part of the published repo
/plan/
/docs/superpowers/

# Local environment secrets — ANTHROPIC_API_KEY for the gated eval, etc.
# (also covered by the global gitignore; pinned here so a fresh clone is safe)
.env

# Full record of a live evaluator run: prompts, turns, tool calls, server logs
# and answers. Useful locally for post-hoc analysis, too big and too volatile to
# track.
/eval-record.jsonl
